# App do Navalha (Expo). Copie para .env.local e ajuste.
# No celular físico, troque localhost pelo IP do computador na rede (ex.: http://192.168.0.10:3000);
# no emulador Android, use 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=chave-publica-do-supabase
# Botão "Simular pagamento do Pix", só com o gateway de mentira (PAGAMENTOS=fake no web).
EXPO_PUBLIC_SIMULAR_PIX=1
