# Copie para .env.local. Valores locais vêm de `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local: segredo HS256 do Supabase CLI. Em produção, deixe vazio (verifica pelo JWKS).
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
NEXT_PUBLIC_URL_PUBLICA=http://localhost:3000

# Pagamentos: "fake" (padrão) ou "asaas".
PAGAMENTOS=fake
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_CHAVE=
ASAAS_WEBHOOK_TOKEN=
NAVALHA_CHAVE_PIX=

# Inngest: em dev, rode `npx inngest-cli@latest dev` (o SDK detecta pelo INNGEST_DEV).
INNGEST_DEV=1

# Notificações (opcionais).
EXPO_ACCESS_TOKEN=
RESEND_CHAVE=
EMAIL_REMETENTE=Navalha <oi@navalha.app>

# Origens que podem chamar a API pelo navegador (ex.: o app Expo rodando na web).
CORS_ORIGENS=http://localhost:8081
